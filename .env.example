# Copy to .env.local and fill in. (Server restart needed after changes.)
# Groq key for AI code generation (get one at https://console.groq.com).
# Users can also paste a key in Dashboard → AI settings (stored in their browser).
GROQ_API_KEY=
# Optional: override the Groq models (comma-separated, tried in order).
# Default: openai/gpt-oss-120b, moonshotai/kimi-k2-instruct-0905, qwen/qwen3-32b, openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: override the Sepolia RPC used for balances + embedded-wallet deploys.
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
